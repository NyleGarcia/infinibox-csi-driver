  21: |
    apiVersion: v1
    kind: Service
    metadata:
      name: node-socat-service
      namespace: null
    spec:
      ports:
        - nodePort: 30008
          port: 10001
          protocol: TCP
      selector:
        app: t-node
      type: NodePort
  22: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      name: t-node
      namespace: ibox
    spec:
      selector:
        matchLabels:
          app: t-node
      template:
        metadata:
          labels:
            app: t-node
        spec:
          containers:
            - args:
                - tcp-listen:10001,fork,reuseaddr
                - unix-connect:/var/run/csi/csi.sock
              image: alpine/socat:1.0.3
              name: socat
              volumeMounts:
                - mountPath: /var/run/csi
                  name: driver-path
            - args:
                - --v=5
                - --csi-address=$(ADDRESS)
                - --health-port=9807
              env:
                - name: ADDRESS
                  value: /var/run/csi/csi.sock
              image: registry.k8s.io/sig-storage/livenessprobe:v2.15.0
              imagePullPolicy: IfNotPresent
              name: liveness-probe
              volumeMounts:
                - mountPath: /var/run/csi
                  name: driver-path
            - env:
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: CSI_DRIVER_ROLE
                  value: node
                - name: CSI_ENDPOINT
                  value: unix:///var/lib/kubelet/plugins/infinibox.infinidat.com/csi.sock
                - name: PRIMARY_IBOX_CREDENTIAL
                  value: infinibox-creds
                - name: APP_LOG_LEVEL
                  value: info
                - name: BURST_LIMIT
                  value: "100"
                - name: QPS_LIMIT
                  value: "50"
                - name: APP_LOG_FORMAT
                  value: json
                - name: PROTOCOL_SECRET
                  value: ""
                - name: CREATE_EVENTS
                  value: ""
                - name: IBOX_HOST_NAMING_CONVENTION
                  value: ""
                - name: CLEANUP_NFS_PERMS
                  value: ""
                - name: MULTIPATH_CLEANUP_DELAY
                  value: ""
                - name: MULTIPATH_WAIT
                  value: ""
                - name: MULTIPATH_FLUSH_RETRIES
                  value: ""
                - name: MULTIPATH_FLUSH_RETRY_DELAY_SECONDS
                  value: ""
                - name: FC_SEARCH_DISK_DELAY
                  value: ""
                - name: RESIZE2FS_DELAY
                  value: ""
                - name: CSI_DRIVER_NAME
                  value: infinibox-csi-driver
                - name: KUBE_NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: NODE_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
              image: docker.io/infinidat/infinidat-csi-driver:v2.30.0
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 5
                httpGet:
                  path: /healthz
                  port: liveness-port
                initialDelaySeconds: 10
                periodSeconds: 2
                timeoutSeconds: 3
              name: driver
              ports:
                - containerPort: 9807
                  name: liveness-port
                  protocol: TCP
              resources:
                limits:
                  cpu: "0.5"
                  memory: 450Mi
                requests:
                  cpu: "0.1"
                  memory: 150Mi
              securityContext:
                allowPrivilegeEscalation: true
                capabilities:
                  add:
                    - SYS_ADMIN
                privileged: true
              volumeMounts:
                - mountPath: /var/lib/kubelet/plugins/infinibox.infinidat.com
                  name: driver-path
                - mountPath: /host
                  mountPropagation: Bidirectional
                  name: host-dir
            - args:
                - --v=5
                - --csi-address=$(ADDRESS)
                - --kubelet-registration-path=/var/lib/kubelet/plugins/infinibox.infinidat.com/csi.sock
              env:
                - name: ADDRESS
                  value: /csi/csi.sock
                - name: KUBE_NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: NODE_IP_ADDRESS
                  valueFrom:
                    fieldRef:
                      fieldPath: status.podIP
              image: registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.15.0
              imagePullPolicy: IfNotPresent
              name: registrar
              volumeMounts:
                - mountPath: /registration
                  name: registration-dir
                - mountPath: /csi
                  name: driver-path
          dnsPolicy: Default
          hostNetwork: true
          imagePullSecrets: []
          serviceAccount: t-node
          volumes:
            - hostPath:
                path: /var/lib/kubelet/plugins_registry/
                type: DirectoryOrCreate
              name: registration-dir
            - hostPath:
                path: /var/lib/kubelet/plugins/infinibox.infinidat.com
                type: DirectoryOrCreate
              name: driver-path
            - hostPath:
                path: /
                type: Directory
              name: host-dir
