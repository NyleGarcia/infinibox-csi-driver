  26: |
    apiVersion: v1
    data:
      iscsi.network_space: ZGVmYXVsdF9pc2NzaV9zcGFjZQ==
      iscsi.useCHAP: bm9uZQ==
      nfs.network_space: ZGVmYXVsdF9uYXNfc3BhY2U=
      nvme.network_space: ZGVmYXVsdF9udm1lX3NwYWNl
      storage_protocol: ZmM=
