  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: t-csi-attacher-role
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: t-external-attacher-runner
    subjects:
      - kind: ServiceAccount
        name: t-controller
        namespace: ibox
  3: |
    apiVersion: v1
    kind: Service
    metadata:
      name: socat-service
      namespace: null
    spec:
      ports:
        - nodePort: 30007
          port: 10000
          protocol: TCP
      selector:
        app: t-driver
      type: NodePort
  4: |
    apiVersion: apps/v1
    kind: StatefulSet
    metadata:
      name: t-driver
      namespace: ibox
    spec:
      replicas: 1
      selector:
        matchLabels:
          app: t-driver
      serviceName: t-driver
      template:
        metadata:
          labels:
            app: t-driver
        spec:
          affinity:
            podAntiAffinity:
              preferredDuringSchedulingIgnoredDuringExecution:
                - podAffinityTerm:
                    labelSelector:
                      matchLabels:
                        app: t-driver
                    topologyKey: kubernetes.io/hostname
                  weight: 100
          containers:
            - args:
                - tcp-listen:10000,fork,reuseaddr
                - unix-connect:/var/run/csi/csi.sock
              image: alpine/socat:1.0.3
              name: socat
              volumeMounts:
                - mountPath: /var/run/csi
                  name: driver-path
            - args:
                - --csi-addons-address=$(CSI_ADDONS_ENDPOINT)
                - --namespace=$(POD_NAMESPACE)
                - --pod=$(POD_NAME)
                - --pod-uid=$(POD_UID)
                - --node-id=$(NODE_ID)
                - --controller-port=8080
                - --enable-volume-condition=false
              env:
                - name: NODE_ID
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: POD_UID
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.uid
                - name: POD_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.podIP
                - name: POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
                - name: CSI_ADDONS_ENDPOINT
                  value: unix:///csi/csi-addons.sock
              image: quay.io/csiaddons/k8s-sidecar:v0.14.0
              imagePullPolicy: IfNotPresent
              name: csiaddons
              volumeMounts:
                - mountPath: /csi
                  name: driver-path
            - args:
                - --csi-address=$(ADDRESS)
                - --leader-election-namespace=$(POD_NAMESPACE)
                - --leader-election=true
                - --v=5
              env:
                - name: ADDRESS
                  value: /var/run/csi/csi.sock
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: registry.k8s.io/sig-storage/csi-attacher:v4.10.0
              imagePullPolicy: IfNotPresent
              name: attacher
              securityContext:
                allowPrivilegeEscalation: true
                capabilities:
                  add:
                    - SYS_ADMIN
                privileged: true
              volumeMounts:
                - mountPath: /var/run/csi
                  name: driver-path
            - args:
                - --csi-address=$(ADDRESS)
                - --leader-election-namespace=$(POD_NAMESPACE)
                - --leader-election=true
                - --volume-name-prefix=ibox
                - --volume-name-uuid-length=10
                - --extra-create-metadata
                - --v=5
              env:
                - name: ADDRESS
                  value: /var/run/csi/csi.sock
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: registry.k8s.io/sig-storage/csi-provisioner:v6.0.0
              imagePullPolicy: IfNotPresent
              name: provisioner
              volumeMounts:
                - mountPath: /var/run/csi
                  name: driver-path
            - args:
                - --csi-address=$(ADDRESS)
                - --v=5
                - --leader-election-namespace=$(POD_NAMESPACE)
                - --leader-election=true
                - --feature-gates=CSIVolumeGroupSnapshot=true
                - --extra-create-metadata=true
                - --snapshot-name-prefix=ibox
                - --snapshot-name-uuid-length=10
              env:
                - name: ADDRESS
                  value: /var/run/csi/csi.sock
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: registry.k8s.io/sig-storage/csi-snapshotter:v8.4.0
              imagePullPolicy: IfNotPresent
              name: snapshotter
              volumeMounts:
                - mountPath: /var/run/csi
                  name: driver-path
            - args:
                - --v=5
                - --csi-address=$(ADDRESS)
                - --leader-election-namespace=$(POD_NAMESPACE)
                - --leader-election=true
              env:
                - name: ADDRESS
                  value: /var/run/csi/csi.sock
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: registry.k8s.io/sig-storage/csi-resizer:v2.0.0
              imagePullPolicy: IfNotPresent
              name: resizer
              volumeMounts:
                - mountPath: /var/run/csi
                  name: driver-path
            - args:
                - --v=5
                - --csi-address=$(ADDRESS)
                - --health-port=9808
              env:
                - name: ADDRESS
                  value: /var/run/csi/csi.sock
              image: registry.k8s.io/sig-storage/livenessprobe:v2.15.0
              imagePullPolicy: IfNotPresent
              name: liveness-probe
              volumeMounts:
                - mountPath: /var/run/csi
                  name: driver-path
            - args:
                - --health-probe-bind-address=:8090
                - --leader-elect=true
                - --leader-elect-namespace=$(POD_NAMESPACE)
              env:
                - name: IBOXCG_CONTROLLER
                  value: "true"
                - name: APP_LOG_LEVEL
                  value: info
                - name: APP_LOG_FORMAT
                  value: json
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: docker.io/infinidat/infinidat-csi-driver:v2.30.0
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 5
                httpGet:
                  path: /healthz
                  port: healthz7
                initialDelaySeconds: 10
                periodSeconds: 2
                timeoutSeconds: 3
              name: iboxcg
              ports:
                - containerPort: 8090
                  name: healthz7
                  protocol: TCP
              securityContext:
                allowPrivilegeEscalation: true
                capabilities:
                  add:
                    - SYS_ADMIN
                privileged: true
            - args:
                - --leader-elect=true
                - --leader-elect-namespace=$(POD_NAMESPACE)
                - --health-probe-bind-address=:8088
              env:
                - name: IBOXPROMOTE_CONTROLLER
                  value: "true"
                - name: APP_LOG_LEVEL
                  value: info
                - name: APP_LOG_FORMAT
                  value: json
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: docker.io/infinidat/infinidat-csi-driver:v2.30.0
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 5
                httpGet:
                  path: /healthz
                  port: healthz2
                initialDelaySeconds: 10
                periodSeconds: 2
                timeoutSeconds: 3
              name: iboxpromote
              ports:
                - containerPort: 8088
                  name: healthz2
                  protocol: TCP
              securityContext:
                allowPrivilegeEscalation: true
                capabilities:
                  add:
                    - SYS_ADMIN
                privileged: true
            - args:
                - --health-probe-bind-address=:8081
                - --leader-elect=true
                - --leader-elect-namespace=$(POD_NAMESPACE)
              env:
                - name: IBOXREPLICA_CONTROLLER
                  value: "true"
                - name: APP_LOG_LEVEL
                  value: info
                - name: APP_LOG_FORMAT
                  value: json
                - name: PROTOCOL_SECRET
                  value: null
                - name: NODE_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: docker.io/infinidat/infinidat-csi-driver:v2.30.0
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 5
                httpGet:
                  path: /healthz
                  port: healthz1
                initialDelaySeconds: 10
                periodSeconds: 2
                timeoutSeconds: 3
              name: iboxreplica
              ports:
                - containerPort: 8081
                  name: healthz1
                  protocol: TCP
              securityContext:
                allowPrivilegeEscalation: true
                capabilities:
                  add:
                    - SYS_ADMIN
                privileged: true
            - env:
                - name: CSI_DRIVER_ROLE
                  value: controller
                - name: CSI_ADDONS_ENDPOINT
                  value: unix:///var/run/csi/csi-addons.sock
                - name: CSI_ENDPOINT
                  value: unix:///var/run/csi/csi.sock
                - name: CREATE_EVENTS
                  value: ""
                - name: PRIMARY_IBOX_CREDENTIAL
                  value: infinibox-creds
                - name: BURST_LIMIT
                  value: "100"
                - name: QPS_LIMIT
                  value: "50"
                - name: PROTOCOL_SECRET
                  value: null
                - name: APP_LOG_LEVEL
                  value: info
                - name: APP_LOG_FORMAT
                  value: json
                - name: IBOX_HOST_NAMING_CONVENTION
                  value: null
                - name: CSI_DRIVER_NAME
                  value: infinibox-csi-driver
                - name: KUBE_NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: NODE_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
                - name: POD_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.podIP
                - name: POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: docker.io/infinidat/infinidat-csi-driver:v2.30.0
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 5
                httpGet:
                  path: /healthz
                  port: healthz
                initialDelaySeconds: 10
                periodSeconds: 2
                timeoutSeconds: 3
              name: driver
              ports:
                - containerPort: 9808
                  name: healthz
                  protocol: TCP
              resources:
                limits:
                  cpu: "0.5"
                  memory: 450Mi
                requests:
                  cpu: "0.1"
                  memory: 150Mi
              securityContext:
                allowPrivilegeEscalation: true
                capabilities:
                  add:
                    - SYS_ADMIN
                privileged: true
              volumeMounts:
                - mountPath: /var/run/csi
                  name: driver-path
          dnsPolicy: Default
          imagePullSecrets: []
          serviceAccount: t-controller
          volumes:
            - emptyDir: null
              name: driver-path
